<?xml version="1.0" encoding="utf-8"?>
<!--
  ZorvAI 品牌标（启动页 / 品牌位全量标）：深空渐变圆角底 + 白 Z 字标 + 青点。
  与宿主 app ic_launcher_foreground / ic_launcher_background 同源同构，但独立命名
  （dshm_ 前缀）：本模块作为 ZorvAI library 内置，同名资源会在合并时篡夺宿主矢量。
  历史说明：此处原为 kelai141/dsh-mobile-apk 的鲸鱼 PNG（dshm_ic_launcher），
  #407 已整体替换为 ZorvAI 品牌。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深空渐变圆角底（品牌基色，半径 24/108） -->
    <path android:pathData="M24,0 H84 A24,24 0 0,1 108,24 V84 A24,24 0 0,1 84,108 H24 A24,24 0 0,1 0,84 V24 A24,24 0 0,1 24,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#0B2A3A"
                android:endColor="#06121F" />
        </aapt:attr>
    </path>

    <!-- Z 字标记（白，粗圆角笔画，居中安全区） -->
    <path
        android:pathData="M34,40 H74 L34,70 H74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 端侧 / on-device 节点（青点） -->
    <path
        android:pathData="M80,38 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#22D3EE" />
</vector>
