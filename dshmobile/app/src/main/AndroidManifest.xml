<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- 外部工作区：bash 进程需要访问用户选择的目录（Android 11+ 分区存储）。 -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <!-- #120（2026-09）：Android 8/9（无分区存储）外部工作区放行所需运行时权限；
       maxSdkVersion=32 保证 Android 13+ 不重复申请（Android 13 起并入 READ_MEDIA_* 且工作区走 All Files Access）。 -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- 0.13.0 F2/M3.4：开机自启（恢复用户同意的状态）与前台唤醒锁（标准档位）；电池优化白名单引导。 -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- 0.13.8 批 H：APK 自更新（UpdateChecker）——唤起系统安装器需要此声明。 -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <!-- 0.13.2 W7：悬浮球（系统级悬浮窗，用户经设置页授予；OverlayController 引导）。 -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- 内置为 ZorvAI 的 library 模块：application 级身份属性（label/icon/theme/backup/
       networkSecurityConfig 等）全部由宿主 app 决定，本 manifest 不设；
       ShizukuProvider 由宿主 app manifest 统一声明（authority 同为 ${applicationId}.shizuku）。 -->
  <application>

    <service
      android:name=".EngineService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- 0.13.2 ADB 输入通道 IME（ADBKeyboard 协议；android_ui_input 中文输入；
         仅在被选为当前输入法时提交文本，见 AdbKeyboardService.canCommit）。 -->
    <service
      android:name=".AdbKeyboardService"
      android:exported="true"
      android:permission="android.permission.BIND_INPUT_METHOD"
      android:label="@string/adb_keyboard_label">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/input_method" />
    </service>

    <!-- ADBKeyboard 协议广播入口（ADB_INPUT_TEXT/ADB_CLEAR_TEXT）；仅在 IME 活跃时生效。
         0.14.8 #413：targetSdk 26+ 的 manifest 接收器收不到**隐式**广播（设备实测 0 个接收者），
         因此点名组件/点名包的广播由本组件承接；纯隐式广播由 AdbKeyboardService 在 IME
         活跃期运行期注册的接收器承接（两个实例按投递方式分工，见 AdbKeyboardReceiver）。 -->
    <receiver
      android:name=".AdbKeyboardReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="ADB_INPUT_TEXT" />
        <action android:name="ADB_CLEAR_TEXT" />
      </intent-filter>
    </receiver>

    <!-- 0.13.2 W7：悬浮球实时面板（TYPE_APPLICATION_OVERLAY + FileObserver 事件流）。 -->
    <service
      android:name=".OverlayService"
      android:exported="false" />

    <!-- 0.13.5 W4：设备控制无障碍服务（语义控制面：按需取节点快照 + performAction）。
         用户在系统设置里开启一次即生效；未开启时控制通道失败关闭（回退 ADB 通道）。 -->
    <service
      android:name=".DeviceControlService"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:label="@string/a11y_service_label">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
    </service>

    <!-- 0.13.0 F2/M3.4：开机自启接收器（恢复用户上次同意的运行状态；restart 后需已启动过）。 -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!-- 0.14.0-preview §6.3.1：通知动作接收器（提问直接回复 / 选项 / 审批批准拒绝 / 提交失败重试）。
         本通道存在处理通知动作的 receiver，且 exported="false" + 动作 PendingIntent 为显式 Intent
         （component 指向本包 receiver）。外部应用无法构造有效动作。 -->
    <receiver
      android:name=".NotifyActionReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.ai.assistance.quro.dshmobile.action.NOTIFY_ACTION" />
      </intent-filter>
    </receiver>

    <!-- 内置为 library 后不再注册 MAIN/LAUNCHER 与 VIEW/SEND 入口（宿主 ZorvAI 工具箱显式拉起本
         Activity）；主题显式挂 Theme.Dsh，不继承宿主的 application 主题。 -->
    <activity
      android:name=".MainActivity"
      android:enableOnBackInvokedCallback="true"
      android:exported="false"
      android:theme="@style/Theme.Dsh"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:windowSoftInputMode="adjustResize" />

    <!-- 内置控制台：快照 bash 交互终端（引擎未运行时也可排查）。 -->
    <activity android:name=".RepairActivity" android:exported="false"
      android:theme="@style/Theme.Dsh"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name=".ConsoleActivity"
      android:exported="false"
      android:theme="@style/Theme.Dsh"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:windowSoftInputMode="adjustResize" />

    <!-- 外部阅读器打开文件（issue #52）：FileProvider 向 ACTION_VIEW 目标
         授予临时读权限。authority 加 .dshm_ 前缀避开宿主自有 ${applicationId}.fileprovider；
         路径映射用本模块独有资源 dshm_file_paths（不被宿主同名资源覆盖）。
         🔴 类名必须用子类 .DshmFileProvider（不是 androidx.core.content.FileProvider 本身）：
         合并器以 android:name 为元素身份键，与宿主同用基类会被并成同一 provider，
         authorities/FILE_PROVIDER_PATHS 冲突且宿主优先 ⇒ 本模块文件分享全灭。 -->
    <provider
      android:name=".DshmFileProvider"
      android:authorities="${applicationId}.dshm_fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/dshm_file_paths" />
    </provider>
  </application>
</manifest>
