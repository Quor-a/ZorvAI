<?xml version="1.0" encoding="utf-8"?>
<!--
  GenUI 图标 — 天气
  设计理念：简约的云朵 + 太阳半露
  不是卡通风格，而是精致的几何线条
  风格：精致线条风，2dp 线宽，圆角端点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 太阳（半圆弧，从云后露出） -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#FEF3C7"
        android:pathData="M7.5,9a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"/>

    <!-- 太阳光线（上半部分） -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,2 L12,4 M6.5,4 L8,5.5 M17.5,4 L16,5.5 M3.5,7.5 L5.5,8.5 M20.5,7.5 L18.5,8.5"/>

    <!-- 云朵主体（底部大云） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#F0FDFA"
        android:pathData="M5.5,17.5c0,-2.5 2,-4.5 4.5,-4.5c0.5,-1.5 2,-2.5 3.5,-2.5c2,0 3.5,1.5 4,3c2,0 3.5,1.5 3.5,4c0,0 0,0 0,0H5.5z"/>

    <!-- 云朵高光（顶部弧线） -->
    <path
        android:strokeColor="#CCFBF1"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M8,14.5c1,-0.5 2.5,-0.5 4,0c1,0.5 2,1 3,1"/>

    <!-- 雨滴（两滴，点缀） -->
    <path
        android:fillColor="#0D9488"
        android:pathData="M9.5,20L8.5,21.5h2z"/>
    <path
        android:fillColor="#14B8A6"
        android:pathData="M14.5,20L13.5,21.5h2z"/>

