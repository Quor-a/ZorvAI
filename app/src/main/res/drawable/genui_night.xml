<?xml version="1.0" encoding="utf-8"?>
<!--
  GenUI 图标 — 晚安/月亮
  设计理念：简约的弯月 + 一颗星
  不是卡通月亮，而是精致的几何月牙
  风格：精致线条风，2dp 线宽，圆角端点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 月亮外轮廓（弯月，描边） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#F0FDFA"
        android:pathData="M15.5,5 A8,8 0,1 0,19 17 A6,6 0,0 1,15.5 5 Z"/>

    <!-- 月亮暗面弧线（内阴影线） -->
    <path
        android:strokeColor="#CCFBF1"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M17,7.5 A5.5,5.5 0,1 0,18 15.5"/>

    <!-- 月亮上的环形山（小圆，装饰） -->
    <path
        android:fillColor="#CCFBF1"
        android:pathData="M10,9m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"/>
    <path
        android:fillColor="#CCFBF1"
        android:pathData="M8.5,13m-0.8,0a0.8,0.8 0,1 1,1.6 0a0.8,0.8 0,1 1,-1.6 0"/>

    <!-- 小星星 1（右上，菱形） -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M19,5.5 L20,7 L19,8.5 L18,7 Z"/>

    <!-- 小星星 2（右下，更小） -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M20.5,15 L21.3,16 L20.5,17 L19.7,16 Z"/>

    <!-- 小星星 3（左下） -->
    <path
        android:fillColor="#0D9488"
        android:pathData="M5,18 L5.6,18.8 L5,19.6 L4.4,18.8 Z"/>

</vector>
