    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#F0FDFA"
        android:pathData="M5,12h14a1.5,1.5 0,0 1,1.5 1.5v3a1.5,1.5 0,0 1,-1.5 1.5H5A1.5,1.5 0,0 1,3.5 16.5v-3A1.5,1.5 0,0 1,5 12z"/>

    <!-- 顶层卡片（实心填充，最前景） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#0D9488"
        android:pathData="M6.5,4h11a1.5,1.5 0,0 1,1.5 1.5v6a1.5,1.5 0,0 1,-1.5 1.5h-11A1.5,1.5 0,0 1,5 11.5v-6A1.5,1.5 0,0 1,6.5 4z"/>

    <!-- 顶层卡片内容：标题线 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M8,7h5"/>

    <!-- 顶层卡片内容：内容线 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M8,9.5h7"/>

    <!-- 琥珀色点缀：顶层右上角 -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M15,6.5m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"/>

</vector>
