<?xml version="1.0" encoding="utf-8"?>
<!--
  GenUI 图标 — 对话
  设计理念：不是普通的聊天气泡
  而是两个重叠的圆角矩形，代表双向对话
  风格：精致线条风，2dp 线宽，圆角端点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 大对话气泡（主气泡） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#F0FDFA"
        android:pathData="M4,6h14a2,2 0,0 1,2 2v6a2,2 0,0 1,-2 2h-8l-4,3v-3H6a2,2 0,0 1,-2 -2V8a2,2 0,0 1,2 -2z"/>

    <!-- 小对话气泡（回复气泡，右下） -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#FEF3C7"
        android:pathData="M12,13h7a1.5,1.5 0,0 1,1.5 1.5v2a1.5,1.5 0,0 1,-1.5 1.5h-4l-3,2v-2h-1.5A1.5,1.5 0,0 1,9 16.5v-2A1.5,1.5 0,0 1,12 13z"/>

    <!-- 主气泡内的内容线（简约文字暗示） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M7,9.5h6 M7,12h4"/>

</vector>
