<?xml version="1.0" encoding="utf-8"?>
<!--
  GenUI 应用 Logo
  设计理念：G + U 几何融合，方形圆角外框
  特点：G 的圆弧包裹 U 的竖线，形成"生成界面"的意象
  风格：精致线条 + 实心填充结合，2dp 线宽，圆角端点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外框：圆角方形（深青填充） -->
    <path
        android:fillColor="#0D9488"
        android:pathData="M4,4h16a2,2 0,0 1,2 2v12a2,2 0,0 1,-2 2H4a2,2 0,0 1,-2 -2V6a2,2 0,0 1,2 -2z"/>

    <!-- 内框高光（右上） -->
    <path
        android:fillColor="#14B8A6"
        android:pathData="M6,6h12a1,1 0,0 1,1 1v3H6V7a1,1 0,0 1,1 -1z"/>

    <!-- G 字母：左下圆弧 + 横线（白色描边） -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M7.5,9.5v3a3.5,3.5 0,0 0,3.5 3.5h2.5 M10,13h1.5"/>

    <!-- U 字母：右侧两条竖线 + 底部圆弧（白色描边） -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M14.5,8.5v4.5a2,2 0,0 0,2 2h0a2,2 0,0 0,2 -2V8.5"/>

    <!-- 琥珀色点缀点（右上角，增加温度感） -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M17.5,7.5m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0"/>

</vector>
