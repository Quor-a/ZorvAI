<?xml version="1.0" encoding="utf-8"?>
<!--
  GenUI 图标 — 清除/关闭
  设计理念：不是普通的 X，而是"回旋箭头"的意象
  一个向左回旋的箭头，代表清除/返回/重置
  风格：精致线条风，2dp 线宽，圆角端点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 回旋弧线（上半部分） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M18,12 A6,6 0,0 0,8 8"/>

    <!-- 回旋弧线（下半部分，向左箭头尾部） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8,8 A6,6 0,0 0,8 16"/>

    <!-- 箭头头部（向左指向） -->
    <path
        android:strokeColor="#0D9488"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8,5 L5,8 L8,11"/>

    <!-- 琥珀色点缀点 -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M17,8m-0.8,0a0.8,0.8 0,1 1,1.6 0a0.8,0.8 0,1 1,-1.6 0"/>

</vector>
