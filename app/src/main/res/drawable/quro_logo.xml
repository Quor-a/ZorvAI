<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方底（品牌渐变：青 → 蓝绿） -->
    <path android:pathData="M30,12 H78 A18,18 0 0 1 96,30 V78 A18,18 0 0 1 78,96 H30 A18,18 0 0 1 12,78 V30 A18,18 0 0 1 30,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="12"
                android:endX="96" android:endY="96"
                android:startColor="#0E6FA8"
                android:endColor="#16C9C9" />
        </aapt:attr>
    </path>

    <!-- Z 字标记（白，粗圆角笔画） -->
    <path
        android:pathData="M36,44 H72 L36,68 H72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- resident / on-device 节点（亮青点） -->
    <path
        android:pathData="M80,40 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#BBF7F2" />
</vector>
