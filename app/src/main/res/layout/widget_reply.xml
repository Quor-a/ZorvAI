<?xml version="1.0" encoding="utf-8"?>
<!--
  Zorv AI 桌面卡片（v1.0.58 重写）
  上半区：品牌头 + 最近一条 AI 回复预览（最多 2 行）
  下半区：2×4 功能卡片网格（对话 / 语音 / 提醒 / 知识 / 技能 / 工具 / 终端 / 记忆），
          每张卡片点击进入对应桌面功能（经 MainActivity 的 ui_action 桥接 ChatScreen）。
  视觉：深色科技卡 + cyan accent 分隔线，与圆角按钮一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="0dp"
    android:contentDescription="Zorv AI 桌面卡片">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ═══ 品牌头 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/quro_logo"
                android:contentDescription="Zorv AI"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zorv AI"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 执行体"
                    android:textSize="11sp"
                    android:textColor="#A0E9FF"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ 最近回复（最多 2 行） ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近回复"
            android:textSize="10sp"
            android:textColor="#80C0C0C0"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无新回复"
            android:textSize="12sp"
            android:textColor="#D8D8D8"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- ═══ accent 分隔线 ═══ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2DD4EE"
            android:alpha="0.45"
            android:layout_marginBottom="8dp" />

        <!-- ═══ 功能卡片网格（2 列 × 4 行） ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 行 1：对话 / 语音 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/widget_card_chat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="打开对话">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💬" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="对话" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_card_voice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="语音球">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🎤" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="语音" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 行 2：提醒 / 知识 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/widget_card_schedule"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="定时提醒">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⏰" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="提醒" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_card_knowledge"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="知识库">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📚" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="知识" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 行 3：技能 / 工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/widget_card_skills"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="技能">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="✨" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="技能" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_card_toolbox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="工具箱">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🧰" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="工具" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 行 4：终端 / 记忆 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_card_terminal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="终端">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💻" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="终端" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_card_memory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="6dp"
                    android:contentDescription="记忆">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🧠" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="记忆" android:textSize="11sp" android:textColor="#FFFFFF"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
