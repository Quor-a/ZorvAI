<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      「声明即最小化」：本文件只允许出现「代码里确有调用、且该调用必须依赖此声明才能工作」
      的策略。新增任何一条前，必须先能指出具体调用点。

      ── 当前保留（各有唯一调用点）────────────────────────────────────
        force-lock      → DevicePolicyManager.lockNow()
                          调用点：QuroToolsDeviceAdmin.kt LockScreenTool.run()
                                  QuroDeviceAdminReceiver.kt lockScreen()
                                  QuroPermissionHelper.kt lockScreen()
        disable-camera  → DevicePolicyManager.setCameraDisabled()
                          调用点：QuroToolsDeviceAdmin.kt SetCameraDisabledTool.run()

      ── E-5 已删除（声明了破坏性能力但代码里根本没有实现）──────────────
        wipe-data       无调用。声明它会让系统激活页向用户展示「可以清除设备所有
                        数据」，是严重的信任风险，也是 F-Droid 审核重点。
        reset-password  无调用。同上。

      ── E-11 已删除（全仓查无实据，纯冗余声明）────────────────────────
        limit-password       需 setPasswordQuality / setPasswordMinimum* 才有意义。
                             全仓 grep：0 处调用。
        watch-login          需 onPasswordFailed / onPasswordSucceeded 回调或
                             getCurrentFailedPasswordAttempts。
                             QuroDeviceAdminReceiver 未覆写任何口令回调；全仓 grep：0 处。
        expire-password      需 setPasswordExpirationTimeout / onPasswordExpiring。
                             全仓 grep：0 处调用。
        encrypted-storage    仅 setStorageEncryption()（强制类）需要本声明；
                             getStorageEncryptionStatus()（只读类）本就不需要。
                             两者全仓 grep 均为 0 处调用。

      注：策略集「收缩」对已激活的设备管理员是安全的，用户无需重新激活；
          反向「扩张」才可能要求重新授权。
    -->
    <uses-policies>
        <force-lock />
        <disable-camera />
    </uses-policies>
</device-admin>
