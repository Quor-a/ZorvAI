<view class="page">
  <text class="header">待办清单</text>

  <view class="input-row">
    <input class="input" placeholder="输入后回车添加" value="{{draft}}" bindinput="onInput" />
    <button class="add" bindtap="onAdd">添加</button>
  </view>

  <scroll-view class="list" scroll-y="true">
    <view class="todo" wx:for="{{todos}}" wx:for-item="todo">
      <view class="check" bindtap="onToggle" data-index="{{index}}">
        <text class="check-text">{{todo.done ? '✓' : ''}}</text>
      </view>
      <text class="todo-text {{todo.done ? 'done' : ''}}">{{todo.text}}</text>
      <button class="del" bindtap="onRemove" data-index="{{index}}">×</button>
    </view>
  </scroll-view>

  <view class="footer">
    <text class="stat">共 {{total}} 条，已完成 {{doneCount}} 条</text>
    <button class="clear" bindtap="onClearFinished">清除已完成</button>
  </view>
</view>
