      "prompt": "分享一个关于鲸鱼或海洋的简短冷知识，30 字以内。",
      "enabled": true,
      "order": 30
    },
    {
      "id": "sing",
      "label": "唱首歌",
      "icon": "music",
      "animation": "youxian-hengga",
      "prompt": "用两三句歌词即兴哼一小段，可爱一点，不要真的写长歌。",
      "enabled": true,
      "order": 40
    },
    {
      "id": "eat",
      "label": "开饭啦",
      "icon": "eat",
      "animation": "chi-baifan",
      "prompt": "主人喊开饭了！用一句话开心地回应，带一点吃货感。",
      "enabled": true,
      "order": 50
    },
    {
      "id": "sleep",
      "label": "去睡觉",
      "icon": "sleep",
      "animation": "shuijiao-kaishi",
      "prompt": "主人让你去睡觉。用一句困困的话道晚安。",
      "enabled": true,
      "order": 60
    },
    {
      "id": "wake",
      "label": "快起来",
      "icon": "wake",
      "animation": "shuijiao-qilai",
      "prompt": "主人把你叫醒了。用一句刚睡醒迷糊的话回应。",
      "enabled": true,
      "order": 70
    },
    {
      "id": "token",
      "label": "看看余额",
      "icon": "wallet",
      "animation": "qian-dai-man-yi",
      "prompt": "主人问起额度/余额。用一句俏皮的话回应，不要编造具体数字。",
      "enabled": true,
      "order": 80
    },
    {
      "id": "work",
      "label": "开始工作",
      "icon": "work",
      "animation": "xie-daima",
      "prompt": "主人要开始工作了。说一句鼓劲的短句，20 字以内。",
      "enabled": true,
      "order": 90
    },
    {
      "id": "celebrate",
