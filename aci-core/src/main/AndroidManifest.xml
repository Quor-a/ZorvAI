<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.aci.core" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
        ACI 权限定义（放在 aci-core 库 Manifest 中，会被所有依赖方自动合并）
        ─────────────────────────────────────────────────────────────
        第三方 App 在各自 Manifest 中声明 <uses-permission> 引用这些权限，
        AI 中枢 App 也需要 <uses-permission> 引用。
    -->


    <!-- 基础调用权限：允许 AI 中枢绑定并调用 ACI Service -->
    <permission
        android:name="ai.aci.permission.CALL"
        android:label="ACI Call Permission"
        android:protectionLevel="normal" />

    <!-- 敏感操作权限：涉及支付、删除等危险操作 -->
    <permission
        android:name="ai.aci.permission.CALL_DANGEROUS"
        android:label="ACI Dangerous Call Permission"
        android:protectionLevel="dangerous" />

    <!-- 能力发现权限：允许 AI 中枢查询本应用暴露的能力列表 -->
    <permission
        android:name="ai.aci.permission.DISCOVER"
        android:label="ACI Discover Permission"
        android:protectionLevel="normal" />

</manifest>