# ===== ZorvAI 签名安全加固（scripts/sign.sh 配套）=====
# 上游已有 *.jks / *.keystore / keystore.properties，此处补齐边界情况

# 私钥与凭证（任何形态）
*.keystore.*
keystore.properties.*
.env
.env.*
env.sh
secrets/
.secrets/

# 签名产物（绝不入库）
*-signed.apk
*-unsigned.apk
*-aligned.apk
build/outputs/apk/

# 本地签名环境（若有人误把密钥位放到项目内）
.zorvai-signing/
signing/

# 例外：签名工具脚本本身不含私钥，必须可入库
# （否则会被上面的 *keystore* 通配规则误伤）
!scripts/setup-keystore.sh
!scripts/lib/common.sh

# ⚠️ app/src/main/assets/keystore/ 下的内置宿主密钥**不入库**（2026-09-17 用户明确要求：
# 「推送代码…注意别推送签名」）。它只打进 APK，不进仓库。
# 因此下面这条目录解禁与文件解禁**必须保持关闭**，否则 pre-push 的第 1 层扫描会拦下推送。
# 文件本身留在本机磁盘上，构建照常能打进 APK；新 clone 缺这两个文件也不影响编译，
# 只是内置补签不可用（sign() 会明确报「内置密钥缺失」）。
#!app/src/main/assets/keystore/
#!app/src/main/assets/keystore/zorvai_release.bks
#!app/src/main/assets/keystore/zorvai_release.p12

