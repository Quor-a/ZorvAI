# Built application files
*.apk
# NOTE: 保留端侧 APK 构建器的模板 APK（位于 assets 内，是构建引擎注入 DEX 的底座，非构建产物）
!app/src/main/assets/libs/common/base.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
# NOTE: 保留端侧 APK 构建器源码包（包名 com.ai.assistance.quro.build，目录名恰为 build，
# 与 Gradle 构建输出 build/ 同名，必须显式解除忽略，否则源码不会被提交）
!app/src/main/java/com/ai/assistance/quro/build/
release/

# Gradle files
.gradle/
gradle/wrapper/gradle-wrapper.jar

# Local configuration (SDK path, etc.)
local.properties
gradle.properties.local

# Log/Output files
*.log
build_*.log

# IDE / Editor
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# Kotlin / Compose
.kotlin/
buildTmp/

# Native / NDK
.externalNativeBuild/
.cxx/
*.so.tmp

# OS / misc
nul
*.tmp

# Dev scratch / temp
_novaterm_temp/
measure_sysprompt.py

# Local gradle cache mirror (never commit)
gradle_cache/

# Keystore / signing files (never commit)
*.jks
*.keystore
*.p12
*keystore*
# 注意：keystore.properties 包含密码，不应提交到 git
# 但在本地开发时需要保留此文件
keystore.properties

# Backup / outputs (large files, never commit)
.backup/
outputs/
*.backup
*.bak*
*.bak2
*.orig
*.swp
*.swo
*~
.git-rewrite/

# Large model files
*.onnx
*.tar.gz
*.tar.xz

# Dev test / scratch files
test_*.py
test_*.html
repro_roundtrip.py
audit_tools.py
release-apk-*.md
measure_sysprompt.py

# Internal deliverables / debug docs
deliverables/

# Test certificates
*.pem
*.pk8

