<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      插件 APK 由宿主 DexClassLoader 加载，不是系统安装的应用，
      权限实际来自宿主 ZorvAI（宿主清单已有 INTERNET 等）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/plugin_name">

        <!-- ★ 必须声明：宿主靠这条 meta-data 反射实例化插件入口类 -->
        <meta-data
            android:name="quro.plugin.entry"
            android:value="com.zorv.plugin.zxwidget.ZxWidgetEntry" />

    </application>
</manifest>