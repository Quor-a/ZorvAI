<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TermuxHost AlertDialog style. -->
    <style name="TermuxHostAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#212121</item>
    </style>

    <!-- Light theme drawer buttons. -->
    <style name="TermuxHost.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="TermuxHost.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- BaseActivity themes (MaterialComponents). -->
    <style name="Theme.TermuxHost.Base.Light.DarkActionBar" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/zorv_terracotta</item>
        <item name="colorPrimaryVariant">@color/zorv_terracotta_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/grey_900</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorLink">@color/blue_link_light</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TermuxHost.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TermuxHost.BaseDialog.DayNight</item>
    </style>

    <style name="Theme.TermuxHost.Base.Light.NoActionBar" parent="Theme.TermuxHost.Base.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TermuxHost.Base.DayNight.DarkActionBar" parent="Theme.TermuxHost.Base.Light.DarkActionBar" />
    <style name="Theme.TermuxHost.Base.DayNight.NoActionBar" parent="Theme.TermuxHost.Base.Light.NoActionBar" />

    <!-- BaseDialog overlay. -->
    <style name="ThemeOverlay.TermuxHost.BaseDialog.Light" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/zorv_terracotta</item>
        <item name="colorPrimaryVariant">@color/zorv_terracotta_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/grey_900</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
    </style>
    <style name="ThemeOverlay.TermuxHost.BaseDialog.DayNight" parent="ThemeOverlay.TermuxHost.BaseDialog.Light" />

    <!-- TermuxHost App themes. -->
    <style name="Theme.TermuxHost.Light.DarkActionBar" parent="Theme.TermuxHost.Base.Light.DarkActionBar" />
    <style name="Theme.TermuxHost.Light.NoActionBar" parent="Theme.TermuxHost.Base.Light.NoActionBar" />
    <style name="Theme.TermuxHost.DayNight.DarkActionBar" parent="Theme.TermuxHost.Base.DayNight.DarkActionBar" />
    <style name="Theme.TermuxHost.DayNight.NoActionBar" parent="Theme.TermuxHost.Base.DayNight.NoActionBar" />

    <!-- TermuxHostActivity theme (must not self-reference). -->
    <style name="Theme.TermuxHostActivity.DayNight.NoActionBar" parent="Theme.TermuxHost.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="buttonBarButtonStyle">@style/TermuxHost.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">@color/black</item>
        <item name="termuxActivityDrawerImageTint">@color/white</item>
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/red_400</item>
        <item name="extraKeysButtonBackgroundColor">@color/black</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/grey_500</item>
    </style>

</resources>