<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application>
        <activity
            android:name=".app.TermuxHostActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation"
            android:label="@string/termux_app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxHostActivity.DayNight.NoActionBar">
            <!-- 非桌面入口：由增强终端路由以 Intent 拉起，避免生成第二个图标 -->
        </activity>

        <activity
            android:name=".app.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TermuxHost.DayNight.NoActionBar" />

        <service
            android:name=".app.TermuxHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal sessions must survive in background for user workflows" />
        </service>
    </application>
</manifest>