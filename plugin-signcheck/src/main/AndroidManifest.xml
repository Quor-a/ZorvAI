<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      说明：插件由宿主 DexClassLoader 加载，不是系统安装的应用，
      这里的 uses-permission 不会在系统层生效（权限来自宿主 ZorvAI）。保留声明只为表明意图。
      本插件只读 PackageManager 与插件私有目录，不需要任何额外权限。
    -->

    <application android:label="@string/plugin_name">

        <!-- ★ 必须声明：宿主靠这条 meta-data 反射实例化插件入口类 -->
        <meta-data
            android:name="quro.plugin.entry"
            android:value="com.zorv.plugin.signcheck.SignCheckEntry" />

    </application>
</manifest>
